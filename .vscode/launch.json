{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: surface adapter test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_surface_adapter.py::test_replay_engine_works_with_a_non_playwright_surface_adapter",
        "-v",
        "-s"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug: current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-s"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug: full unit suite (not e2e)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-m", "not e2e", "-v", "-s"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug: demo app (port 8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["demo_app.app:app", "--port", "8001", "--reload"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug: platform API (port 8000)",
      "type": "debugpy",
